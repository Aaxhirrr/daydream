GOOGLE_CLOUD_PROJECT=

# Locations
DAYDREAM_GEMINI_LOCATION=global
DAYDREAM_VEO_LOCATION=us-central1
DAYDREAM_LYRIA_LOCATION=us-central1

# Required on Vercel / serverless to persist generated media (videos, hero frames, audio).
# Example: my-daydream-bucket
DAYDREAM_ASSET_BUCKET=

# Vercel / serverless deployment:
# Put the full Service Account JSON here as a single-line JSON string.
# (Alternatively, the app will try to reuse FIREBASE_* service account creds if set.)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Models (optional overrides)
DAYDREAM_TEXT_MODEL=gemini-2.5-flash
DAYDREAM_IMAGE_MODEL=gemini-2.5-flash-image
DAYDREAM_VEO_MODEL=veo-3.1-generate-preview
DAYDREAM_LYRIA_MODEL=lyria-002

# Optional: Firebase Admin (for Firestore thread persistence)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
